+    /// The absolute y of the **last IN-FLOW line box's baseline** inside `b` — the number CSS 2.1
+    /// §10.8.1 makes an `inline-block`'s baseline.
+    ///
+    /// ⚠ Two words in that sentence are load-bearing and each cost a tick to learn.
+    ///
+    /// **"LAST" is DOCUMENT ORDER, not the lowest on the page.** Taking `max` over the subtree reads
+    /// the bottom-most baseline anywhere inside the atomic, which is whatever the flow pushed
+    /// furthest down — not the last line.
+    ///
+    /// **"IN-FLOW" excludes floats.** A float's box is an ordinary `Block` child, so `walk` descends
+    /// into it and its lines look exactly like the atomic's own; but a float is out of flow and its
+    /// baseline is not a candidate. This needs the STYLE, which is why it is a method: the box tree
+    /// carries no out-of-flow marker (see the standing note on `node_rects`).
+    fn last_line_baseline(&self, b: &LayoutBox) -> Option<f32> {
+        let mut last: Option<f32> = None;
+        b.walk(&mut |bx| {
+            if let Some(n) = bx.node {
+                if let Some(st) = self.styles.get(&n) {
+                    if is_float(st) || is_out_of_flow_positioned(st) {
+                        return;
+                    }
+                }
+            }
+            if let BoxContent::Inline(frags) = &bx.content {
+                if let Some(f) = frags.last() {
+                    last = Some(f.baseline);
+                }
+            }
+        });
+        last
+    }
