 /// PERF.1.1.a: the early scan is on unless `MANUK_NO_EARLY_SCAN` is set (the gate's mutant arm).
+/// W4.E1: the fetch-priority switch. On by default; `MANUK_NO_FETCH_PRIORITY=1` restores the flat
+/// "everything at parse time at once" behaviour (the A/B baseline arm and the gate's mutant).
+fn fetch_priority_enabled() -> bool {
+    std::env::var_os("MANUK_NO_FETCH_PRIORITY").is_none()
+}
+
+/// How long Low-priority (image) warm fetches yield to the render-blocking set at most.
+const LOW_YIELD_MAX: std::time::Duration = std::time::Duration::from_millis(1500);
+
+/// **Priority classes for the speculative fetches of one load.** High = render-blocking CSS, scripts
+/// and the fonts those sheets name; Low = images. A Low fetch waits (bounded by [`LOW_YIELD_MAX`], so
+/// nothing starves) until no High fetch is in flight, so the blocking set gets the connections first.
+#[derive(Default)]
+struct PrioGate {
+    high: std::sync::atomic::AtomicUsize,
+    changed: tokio::sync::Notify,
+}
+
+struct HighGuard(std::sync::Arc<PrioGate>);
+
+impl Drop for HighGuard {
+    fn drop(&mut self) {
+        self.0.high.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
+        self.0.changed.notify_waiters();
+    }
+}
+
+impl PrioGate {
+    /// Register one High fetch; call synchronously where it is spawned so a Low spawned afterwards sees it.
+    fn enter_high(self: &std::sync::Arc<Self>) -> HighGuard {
+        self.high.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        HighGuard(self.clone())
+    }
+    async fn low_wait(&self) {
+        if !fetch_priority_enabled() {
+            return;
+        }
+        let deadline = tokio::time::Instant::now() + LOW_YIELD_MAX;
+        loop {
+            let n = self.changed.notified();
+            tokio::pin!(n);
+            n.as_mut().enable();
+            if self.high.load(std::sync::atomic::Ordering::SeqCst) == 0 {
+                return;
+            }
+            if tokio::time::timeout_at(deadline, n).await.is_err() {
+                return;
+            }
+        }
+    }
+}
