+    /// W4.E1: a Low fetch yields while a High one is in flight, goes the moment it drains, and with
+    /// the switch off does not wait at all (the mutant).
+    #[tokio::test]
+    async fn prio_gate_low_waits_for_high() {
+        let gate = std::sync::Arc::new(PrioGate::default());
+        let g = gate.enter_high();
+        let t0 = std::time::Instant::now();
+        let g2 = gate.clone();
+        let low = tokio::spawn(async move {
+            g2.low_wait().await;
+            t0.elapsed()
+        });
+        tokio::time::sleep(std::time::Duration::from_millis(150)).await;
+        drop(g);
+        let waited = low.await.unwrap();
+        assert!(waited >= std::time::Duration::from_millis(140), "Low went early: {waited:?}");
+        assert!(waited < std::time::Duration::from_millis(1000), "Low did not wake: {waited:?}");
+        let held = gate.enter_high();
+        std::env::set_var("MANUK_NO_FETCH_PRIORITY", "1");
+        let t1 = std::time::Instant::now();
+        gate.low_wait().await;
+        std::env::remove_var("MANUK_NO_FETCH_PRIORITY");
+        drop(held);
+        assert!(t1.elapsed() < std::time::Duration::from_millis(50), "switch off must not wait");
+    }
