+/// **PERF.1.2.b.b.a.b: which fetched dynamic script may run now.** Items are indexed in document
+/// order. An async one (force-async from `createElement`, or the `async` attribute) is ready the
+/// moment it arrives; a non-async one (`async = false`) is ready only when every earlier non-async
+/// one has been released, so ordered loader chains keep their order while an unrelated slow tag no
+/// longer holds the rest behind it.
+pub(crate) struct ArrivalScheduler<T> {
+    is_async: Vec<bool>,
+    /// Document-order indices of the non-async items.
+    ordered: Vec<usize>,
+    next_ordered: usize,
+    held: std::collections::HashMap<usize, T>,
+    ready: std::collections::VecDeque<T>,
+}
+
+impl<T> ArrivalScheduler<T> {
+    pub(crate) fn new(is_async: Vec<bool>) -> Self {
+        let ordered = (0..is_async.len()).filter(|&i| !is_async[i]).collect();
+        Self {
+            is_async,
+            ordered,
+            next_ordered: 0,
+            held: Default::default(),
+            ready: Default::default(),
+        }
+    }
+    pub(crate) fn arrive(&mut self, idx: usize, item: T) {
+        if self.is_async[idx] {
+            self.ready.push_back(item);
+            return;
+        }
+        self.held.insert(idx, item);
+        while let Some(&want) = self.ordered.get(self.next_ordered) {
+            match self.held.remove(&want) {
+                Some(it) => {
+                    self.ready.push_back(it);
+                    self.next_ordered += 1;
+                }
+                None => break,
+            }
+        }
+    }
+    pub(crate) fn pop_ready(&mut self) -> Option<T> {
+        self.ready.pop_front()
+    }
+}
+
+#[cfg(test)]
+mod arrival_scheduler_tests {
+    use super::ArrivalScheduler;
+    fn drain(s: &mut ArrivalScheduler<usize>) -> Vec<usize> {
+        std::iter::from_fn(|| s.pop_ready()).collect()
+    }
+    #[test]
+    fn async_scripts_run_in_arrival_order() {
+        let mut s = ArrivalScheduler::new(vec![true, true, true]);
+        let mut out = vec![];
+        for i in [2, 0, 1] {
+            s.arrive(i, i);
+            out.extend(drain(&mut s));
+        }
+        assert_eq!(out, vec![2, 0, 1]);
+    }
+    #[test]
+    fn async_false_scripts_keep_document_order() {
+        let mut s = ArrivalScheduler::new(vec![false, false, false]);
+        let mut out = vec![];
+        for i in [2, 1, 0] {
+            s.arrive(i, i);
+            out.extend(drain(&mut s));
+        }
+        assert_eq!(out, vec![0, 1, 2]);
+    }
+    #[test]
+    fn a_slow_async_does_not_hold_ordered_ones_and_vice_versa() {
+        // 0 = slow async, 1,2 = ordered
+        let mut s = ArrivalScheduler::new(vec![true, false, false]);
+        s.arrive(2, 2);
+        assert!(drain(&mut s).is_empty());
+        s.arrive(1, 1);
+        assert_eq!(drain(&mut s), vec![1, 2]);
+        s.arrive(0, 0);
+        assert_eq!(drain(&mut s), vec![0]);
+    }
+}
